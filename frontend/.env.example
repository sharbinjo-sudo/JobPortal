# Flutter web runs fully offline against the local Django API.
# Pass the base URL when launching:
#   flutter run -d chrome --dart-define=API_BASE_URL=http://127.0.0.1:8000/api
#
# The default already points at the local Django server, so this file is
# documentation only — no cloud keys or internet services are needed.
API_BASE_URL=http://127.0.0.1:8000/api
