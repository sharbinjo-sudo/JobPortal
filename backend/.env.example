# Local development template — copy to .env and fill in DATABASE_URL.
# The app requires a PostgreSQL database (e.g. Supabase); there is no
# SQLite fallback. With SUPABASE_S3_* unset, uploads go to backend/media/
# and emails print to the Django console.
#
# Special characters in the database password (?, #, @, !, %) must be
# percent-encoded in the URL.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-local-prototype-secret-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required — PostgreSQL (Supabase) connection string.
# Supabase → Project Settings → Database → Connection string → URI.
# Use the session pooler host (port 5432). Example:
# DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Flutter web default port + local API origins.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Flutter Web uses a random development port, so allow loopback ports only.
CORS_ALLOWED_ORIGIN_REGEXES=^http://localhost:[0-9]+$,^http://127\.0\.0\.1:[0-9]+$

# Email — console backend prints messages to the runserver terminal.
# Swap to an SMTP backend when you add a provider, e.g.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_FROM_EMAIL=noreply@localhost

# Supabase Storage (S3-compatible gateway) for resumes, logos, and other
# uploads. Supabase → Project Settings → Storage → S3 connection settings.
# All five values must be set to activate the bucket; otherwise uploads
# fall back to backend/media/. Keep the secret key backend-only.
# SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=ap-south-1
# SUPABASE_S3_BUCKET=resumes
# SUPABASE_S3_ACCESS_KEY_ID=<access key>
# SUPABASE_S3_SECRET_ACCESS_KEY=<secret key>
# How long presigned download links stay valid, in seconds (default 900).
# SUPABASE_S3_URL_EXPIRE=900
